# === 시크릿 (절대 커밋 금지) ===
.env
.env.*
!.env.example
!docs/.env.example

# 앱 자격증명 (시크릿) — public 저장소 전환 시 노출되므로 반드시 제외
data/threads_app.json
data/youtube_client.json
data/mastodon_creds.json
data/*_creds.json
data/*secret*.json

# 인증 시도 중 생성되는 임시 산출물
data/_yt_auth_*.url
data/_yt_auth_*.log
data/_yt_auth_*.err
data/_ps_*.txt
data/_yt_*.xml
_t_ps_*.py

# YouTube OAuth client JSON (client_id/secret 포함)
data/youtube_client.json
data/youtube_account.txt
data/*_creds.json
data/mastodon_creds.json
data/meta_creds.json
data/hf_account.json
data/hf_cookies.json
data/_hfprofile/

# === 대용량 바이너리 ===
models/
*.mp4
*.mov
*.webm

# 렌더링 작업 캐시
images/
work_*/
work_*/
data/work_*/

# 큰 데이터 하위 디렉토리
data/bgm/*.wav
data/bgm/*.mp3
data/cards/
data/fables/*/images/
data/fables/*/work_*/
data/fables/*/fable_*.mp4
data/reels/
data/videos/
data/preview/
data/tts_samples/
data/voice_samples/

# === assets (v5 릴스 전용 — PAUSE 됨, 필요시 scripts/build_sprites.py 로 재생성) ===
# 주의: gitignore 는 아래→위 순서로 규칙을 평가한다.
# 상위 디렉토리(assets/)를 다시 include 하려면 assets/ 자체를 제외한 뒤
# 하위 경로를 개별적으로 해제해야 한다.
assets/**
# BGM 원격 소스 설정은 클라우드 렌더에 필요하므로 예외로 커밋한다.
!assets/bgm_sources.json
# 로이 제공 BGM(assets/bgm/ 아래 음원)도 클라우드 렌더에 필요하므로 커밋한다.
# → 저장소가 public 이므로 **저작권이 확실한 음원만** 여기에 올린다.
!assets/bgm/
assets/bgm/**
!assets/bgm/*.mp3

# === 루트 임시 파일 (백그라운드 디버그/프로브 산출물) ===
_*.py
_*.txt
_*.png
_*.jpg
_*.mp3
_*.wav

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
bin/
lib/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === IDE / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === 로그 / 런타임 ===
*.log
data/errors.log
data/scheduler.log

# === WorkBuddy 프로젝트 메타 (리포와 무관) ===
.workbuddy/

# === 임시 / 백업 ===
*.tmp
*.bak
*.swp
~$*
.git_commit_msg.txt
